  place-items: center;
  font-size: 22px;
  box-shadow: 0 3px 10px #8a16484a;
}

.envelope.open .env-flap {
  transform: rotateX(180deg);
  z-index: 0;
}

.envelope.open .seal {
  opacity: 0;
  transition: .25s;
}

